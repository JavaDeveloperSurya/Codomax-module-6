# ---------------------------------------------------------------------------
# Database — PostgreSQL connection string.
# Neon:      postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Vercel PG: postgres://default:PASSWORD@xxx.aws.neon.tech/verceldb?sslmode=require
# Local:     postgresql://blog:blogpass@127.0.0.1:5432/codomax_blog?schema=public
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# 32+ character random string used to sign session JWTs.
# Generate with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"

# Public base URL of the deployed site (used for SEO metadata + sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
